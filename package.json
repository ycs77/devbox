{
  "name": "@ycs77/devbox",
  "version": "0.7.1",
  "description": "A Lucas Yang's opinionated devbox for AI agents",
  "keywords": [
    "agent",
    "agentic",
    "ai",
    "ai-agents",
    "claude-code",
    "cli",
    "codex",
    "container",
    "devcontainer",
    "development",
    "docker",
    "nodejs"
  ],
  "homepage": "https://github.com/ycs77/devbox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycs77/devbox.git"
  },
  "bin": {
    "devbox": "./bin/devbox.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "check": "pnpm lint && pnpm fmt --check && pnpm typecheck && pnpm test --run",
    "smoke": "node scripts/package-devbox-smoke.mjs",
    "update-actions": "actionspack update",
    "release": "bumpp --commit \"Release v%s\"",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cac": "^7.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "actionspack": "^0.1.5",
    "bumpp": "^12.3.0",
    "memfs": "^4.80.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsdown": "0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0"
}
